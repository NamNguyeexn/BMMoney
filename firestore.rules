rules_version = '2';

// BMMoney - Firestore Security Rules
//
// Nguyen tac duy nhat: moi nguoi chi doc/ghi duoc nhanh users/{uid} cua chinh minh.
// Khong co bat ky duong nao khac duoc mo. Mac dinh cua Firestore la TU CHOI HET,
// nen chi can khong khai bao la da khoa.
//
// Cach nap:  firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Ho so tai khoan: users/{uid}
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // Toan bo du lieu con:
      //   meta/sync, cats/{id}, people/{id}, loans/{loanId}, tx/{id}
      // va ca hai collection cu dang cho don: transactions/{id}, backup/{id}
      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }
  }
}
