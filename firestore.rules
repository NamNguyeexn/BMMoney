rules_version = '2';
// BMM v6 — mỗi tài khoản chỉ đọc/ghi được dữ liệu của chính mình.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn(uid) { return request.auth != null && request.auth.uid == uid; }
    function common(d, id) {                // trường bắt buộc của mọi bảng
      return d.id == id && d.updatedAt is int && d.deleted is bool;
    }
    function optStr(d, k) { return !(k in d) || d[k] == null || d[k] is string; }
    // Bản ghi đã xóa (deleted = true) chỉ cần đúng trường chung, không kiểm tra thêm
    function gone(d) { return d.deleted == true; }

    // ----- Cấu trúc mới v6
    match /accounts/{uid} {
      allow read, write: if signedIn(uid);

      match /settings/{doc} { allow read, write: if signedIn(uid); }
      match /meta/{doc}     { allow read, write: if signedIn(uid); }

      match /categories/{id} {
        allow read, delete: if signedIn(uid);
        allow create, update: if signedIn(uid) && common(request.resource.data, id)
          && (gone(request.resource.data) || request.resource.data.name is string
          && request.resource.data.kind in ['EXPENSE', 'INCOME', 'BOTH']);
      }
      match /people/{id} {
        allow read, delete: if signedIn(uid);
        allow create, update: if signedIn(uid) && common(request.resource.data, id)
          && request.resource.data.name is string;
      }
      match /loans/{id} {
        allow read, delete: if signedIn(uid);
        allow create, update: if signedIn(uid) && common(request.resource.data, id)
          && (gone(request.resource.data) || request.resource.data.direction in ['BORROW', 'LEND']
          && request.resource.data.principal is int && request.resource.data.principal > 0
          && optStr(request.resource.data, 'personId'));
      }
      match /transactions/{id} {
        allow read, delete: if signedIn(uid);
        allow create, update: if signedIn(uid) && common(request.resource.data, id)
          && (gone(request.resource.data) || request.resource.data.type in ['EXPENSE', 'INCOME', 'BORROW', 'LEND', 'REPAY', 'COLLECT']
          && request.resource.data.amount is int && request.resource.data.amount > 0
          && request.resource.data.occurredAt is int
          && optStr(request.resource.data, 'categoryId')
          && optStr(request.resource.data, 'loanId')
          && request.resource.data.get('paymentMethod', null) in [null, 'BANK', 'CASH', 'CARD', 'EWALLET', 'OTHER']);
      }
    }

    // ----- Cấu trúc cũ: giữ quyền để app bản hiện tại vẫn chạy trong lúc chuyển đổi
    match /users/{uid}/{document=**} {
      allow read, write: if signedIn(uid);
    }
  }
}
