<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Ban va 01/08: can quyen nay de biet may co mang hay khong, tu do bao loi
         "khong co mang" ngay lap tuc thay vi de nguoi dung cho Firestore treo -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Ban va 04/08: tu Android 14, SCHEDULE_EXACT_ALARM KHONG con duoc cap san.
         Khong co quyen nay thi bao thuc bi ha xuong loai "khong chinh xac", va trong
         che do Doze he thong don no vao cua so bao tri -> loi nhac tre hang gio hoac
         mat han. USE_EXACT_ALARM duoc cap ngay khi cai, danh cho app co chuc nang
         chinh la bao thuc / loi nhac. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- De mo duoc hop thoai xin bo toi uu pin cho app -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Ban va 03/09: KHONG khai bao READ_MEDIA_IMAGES / READ_EXTERNAL_STORAGE.
         Bo chon anh cua he thong (PickVisualMedia) tra ve mot Uri da duoc cap quyen
         san cho rieng lan chon do, nen app khong can quyen doc toan bo thu vien anh.
         Khoi <queries> cu da bo cung voi chuc nang nghe thong bao. -->

    <application
        android:name=".BmmApp"
        android:largeHeap="false"
        android:allowBackup="true"
        android:icon="@drawable/ic_app_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_app_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.ExpenseManager"
        android:usesCleartextTraffic="false">

        <!-- Ban va 03/09: bao Play services tai san mo hinh doc chu ngay khi cai app.
             Voi ban -bundled thi mo hinh da nam trong APK, the nay chi giup ML Kit
             khoi tao nhanh hon o lan dung dau tien. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr" />

        <!-- Toan bo 5 man hinh moi nam trong MainActivity duoi dang Fragment -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Nhan bao thuc sao luu hang ngay -->
        <receiver
            android:name=".remote.BackupReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- Ban va 04/08: nhieu ROM (Honor, Huawei, Xiaomi) khong gui
                     BOOT_COMPLETED chuan ma gui QUICKBOOT_POWERON -->
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.huawei.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".remote.ReminderReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- Ban va 04/08: nhieu ROM (Honor, Huawei, Xiaomi) khong gui
                     BOOT_COMPLETED chuan ma gui QUICKBOOT_POWERON -->
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.huawei.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Man doc anh giao dich: chon anh o tren, danh sach goi y o duoi.
             Mo tu nut chuong goc tren ben phai trang chu. -->
        <activity
            android:name=".ui.SuggestionsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <!-- Man them ghi chu mo tu mot goi y, quay lai la ve man goi y -->
        <activity
            android:name=".ui.AddNoteActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- Ban va 03/09: cua nhan anh chia se tu app khac (Techcombank, Thu vien anh...).

             Man nay KHONG co giao dien va KHONG luu anh: no doc anh ngay tai cho roi
             chuyen sang man doc anh giao dich, chi dua theo ba con so dem duoc.
             Ly do phai doc ngay tai day: quyen doc Uri chia se chi song trong vong doi
             cua Activity nhan no, ma app thi khong giu ban sao anh de doc tre.

             exported=true la bat buoc de xuat hien trong bang chia se cua he thong. -->
        <activity
            android:name=".ui.ShareReceiptActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

    </application>

</manifest>
