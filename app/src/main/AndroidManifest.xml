<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Ban va 01/08: can quyen nay de biet may co mang hay khong, tu do bao loi
         "khong co mang" ngay lap tuc thay vi de nguoi dung cho Firestore treo -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Ban va 04/08: tu Android 14, SCHEDULE_EXACT_ALARM KHONG con duoc cap san.
         Khong co quyen nay thi bao thuc bi ha xuong loai "khong chinh xac", va trong
         che do Doze he thong don no vao cua so bao tri -> loi nhac tre hang gio hoac
         mat han. USE_EXACT_ALARM duoc cap ngay khi cai, danh cho app co chuc nang
         chinh la bao thuc / loi nhac. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- De mo duoc hop thoai xin bo toi uu pin cho app -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Ban va 14/08: tu Android 11, queryIntentActivities chi tra ve app trong danh sach
         nay. Thieu khoi <queries> thi hop thoai chon nguon thong bao se rong tron. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".BmmApp"
        android:largeHeap="false"
        android:allowBackup="true"
        android:icon="@drawable/ic_app_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_app_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.ExpenseManager"
        android:usesCleartextTraffic="false">

        <!-- Toan bo 5 man hinh moi nam trong MainActivity duoi dang Fragment -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Nhan bao thuc sao luu hang ngay -->
        <receiver
            android:name=".remote.BackupReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- Ban va 04/08: nhieu ROM (Honor, Huawei, Xiaomi) khong gui
                     BOOT_COMPLETED chuan ma gui QUICKBOOT_POWERON -->
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.huawei.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".remote.ReminderReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- Ban va 04/08: nhieu ROM (Honor, Huawei, Xiaomi) khong gui
                     BOOT_COMPLETED chuan ma gui QUICKBOOT_POWERON -->
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.huawei.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Man goi y doc tu thong bao. De rieng thay vi them tab vao thanh dieu huong. -->
        <activity
            android:name=".ui.SuggestionsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <!-- Man them ghi chu mo tu mot goi y, quay lai la ve man goi y -->
        <activity
            android:name=".ui.AddNoteActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- Dich vu doc thong bao.
             android:permission BAT BUOC phai la BIND_NOTIFICATION_LISTENER_SERVICE, neu khong
             he thong se khong bao gio hien app trong trang cap quyen. Nguoi dung phai tu bat
             trong cai dat he thong, khong the xin bang hop thoai. -->
        <service
            android:name=".notify.NotifyListener"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>

</manifest>
