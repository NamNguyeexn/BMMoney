<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Giữ nguyên tên theme cũ, đổi sang bảng màu kem của thiết kế mới -->
    <style name="Theme.ExpenseManager" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/olive</item>
        <item name="colorPrimaryDark">@color/dark_green</item>
        <item name="colorAccent">@color/burnt</item>
        <item name="android:statusBarColor">@color/cream</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/cream</item>
        <item name="android:navigationBarColor">@color/cream</item>
        <item name="android:textColor">@color/dark_green</item>
    </style>

    <!-- Hộp thoại xác nhận (Sao lưu / Lấy về / Đăng xuất / Xoá danh mục) theo màu app -->
    <style name="Theme.Bmm.Dialog" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <item name="colorPrimary">@color/olive</item>
        <item name="colorAccent">@color/burnt</item>
        <item name="android:textColorPrimary">@color/dark_green</item>
        <item name="android:textColorSecondary">@color/olive</item>
        <item name="android:background">@color/card_cream</item>
        <item name="buttonBarPositiveButtonStyle">@style/Bmm.DialogButton.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/Bmm.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Bmm.DialogButton</item>
        <item name="shapeAppearanceOverlay">@style/Bmm.DialogShape</item>
    </style>

    <style name="Bmm.DialogShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="Bmm.DialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/olive</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Bmm.DialogButton.Positive" parent="Bmm.DialogButton">
        <item name="android:textColor">@color/burnt</item>
    </style>

    <!-- Kiểu chữ bám theo thiết kế web -->
    <!-- Style cha bat buoc phai co vi ten cac style con dung dau cham (Text.H1...) -->
    <style name="Text" parent="" />

    <style name="Text.H1" parent="Text">
        <item name="android:textSize">25sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/dark_green</item>
    </style>
    <style name="Text.H3" parent="Text">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/dark_green</item>
    </style>
    <style name="Text.Body" parent="Text">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/olive</item>
    </style>
    <style name="Text.Small" parent="Text">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/olive</item>
    </style>
    <style name="Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">4dp</item>
        <item name="cardBackgroundColor">@color/card_cream</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
</resources>
