<?xml version="1.0" encoding="utf-8"?>
<!--
  Ban va 02/08. Mot dong trong the "Bao cao no" o man Phan tich.
  Trai: bieu tuong loai. Giua: ten nguoi + han. Phai: so tien.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_field"
    android:clickable="true"
    android:focusable="true"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:minHeight="60dp"
    android:orientation="horizontal"
    android:padding="12dp">

    <TextView
        android:id="@+id/tv_debt_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_lend"
        android:gravity="center"
        android:text="↪"
        android:textColor="@color/dark_green"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_debt_person"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Tên người"
            android:textColor="@color/dark_green"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_debt_due"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Hạn đòi 01/01/2026"
            android:textColor="@color/olive"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_debt_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:singleLine="true"
        android:text="0 ₫"
        android:textColor="@color/burnt"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
