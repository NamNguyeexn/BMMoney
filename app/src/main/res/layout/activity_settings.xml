<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_main">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:paddingBottom="104dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingLeft="20dp" android:paddingRight="20dp" android:paddingTop="48dp" android:paddingBottom="128dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cài đặt giao diện" android:textColor="#FFFFFF" android:textSize="30sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Chọn bộ màu lấy cảm hứng từ Coolors Trending" android:textColor="#D0D5DD" android:textSize="14sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnSyncNow" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="22dp" android:backgroundTint="#12B76A" android:text="Đồng bộ cloud thủ công" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="16sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Dán link palette Coolors" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" />
            <EditText android:id="@+id/edtCoolorsUrl" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="10dp" android:background="@drawable/bg_input" android:hint="VD: https://coolors.co/101828-344054-7f56d9-12b76a-f04438" android:inputType="textUri" android:padding="16dp" android:textColor="#FFFFFF" android:textColorHint="#98A2B3" android:textSize="13sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Bộ màu gợi ý" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" />
            <LinearLayout android:id="@+id/paletteList" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="86dp" android:layout_gravity="bottom" android:background="@drawable/bg_bottom_nav_modern" android:elevation="16dp" android:gravity="center" android:orientation="horizontal" android:paddingLeft="22dp" android:paddingRight="22dp"><TextView android:id="@+id/navHome" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="🏠\nTrang chủ" android:textColor="#667085" android:textSize="13sp"/><TextView android:id="@+id/navCalendar" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="📅\nLịch" android:textColor="#667085" android:textSize="13sp"/><Space android:layout_width="78dp" android:layout_height="1dp"/><TextView android:id="@+id/navReport" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="📊\nBáo cáo" android:textColor="#667085" android:textSize="13sp"/><TextView android:id="@+id/navSettings" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="⚙️\nCài đặt" android:textColor="#7F56D9" android:textSize="13sp" android:textStyle="bold"/></LinearLayout>
    <com.google.android.material.floatingactionbutton.FloatingActionButton android:id="@+id/fabAdd" android:layout_width="72dp" android:layout_height="72dp" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="46dp" app:backgroundTint="#7F56D9" app:srcCompat="@android:drawable/ic_input_add" app:tint="@android:color/white" />
</FrameLayout>
