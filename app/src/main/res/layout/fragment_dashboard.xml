<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/refresh_dashboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream">

    <ScrollView

    android:id="@+id/screen_dashboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="120dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Xin chào, Linh! \uD83D\uDC4B"
                android:textSize="25sp"
                android:textStyle="bold"
                android:textColor="@color/dark_green" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Duy trì thói quen ghi lại chi tiêu rất tốt !!"
                android:textSize="15sp"
                android:textColor="@color/olive" />
        </LinearLayout>

        <!-- Ban va 14/08: nut chuong mo man goi y doc tu thong bao.
             So tren huy hieu la so goi y dang cho, dat trong FrameLayout de huy hieu
             deo len goc nut chu khong day nut lech di. -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/btn_bell"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_pill_cream"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="\uD83D\uDD14"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/tv_bell_badge"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_badge_warning"
                android:gravity="center"
                android:text="0"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/cream"
                android:visibility="gone" />
        </FrameLayout>

    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="10dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_summary_gradient"
            android:padding="24dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                >
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tổng chi tiêu tháng này"
                android:textSize="15sp"
                android:textColor="@color/subtle_text"
                />
            <TextView
                android:id="@+id/tv_total_expense"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="65.481.000 ₫"
                android:textSize="31sp"
                android:textColor="@color/cream"
                android:textStyle="bold"
                />
            </LinearLayout>
            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_translucent_icon"
                >
                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_dollar"
                    app:tint="@color/cream" />
            </FrameLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="24dp"
                >
            <TextView
                android:id="@+id/tv_budget_line"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Ngân sách: 80.500.000 ₫"
                android:textSize="14sp"
                android:textColor="@color/subtle_text"
                android:layout_weight="1"
                />
<!--            <TextView-->
<!--                android:layout_marginRight="12dp"-->
<!--                android:textColor="@color/olive"-->
<!--                />-->
            <TextView
                android:id="@+id/tv_remaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Còn lại: 15.019.000 ₫"
                android:textSize="14sp"
                android:textColor="@color/subtle_text"
                />
            </LinearLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:background="@drawable/bg_track_translucent"
                android:layout_marginTop="12dp"
                >
                <View
                    android:id="@+id/budget_bar"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bar_sandy" />
            </FrameLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp"
                >
            <TextView
                android:id="@+id/tv_used_percent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="81.3% đã dùng"
                android:textSize="13sp"
                android:textColor="@color/subtle_text"
                android:layout_weight="1"
                />
            <TextView
                android:id="@+id/tv_days_left"
                android:clickable="true"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Còn 9 ngày"
                android:textSize="13sp"
                android:textColor="@color/subtle_text"
                />
            </LinearLayout>
            <TextView
                android:id="@+id/tv_over_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:background="@drawable/bg_badge_warning"
                android:text="Bạn đang vượt mức chi tiêu kỳ này"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/cream"
                android:visibility="gone" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:cardBackgroundColor="@color/card_cream"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                >
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Chi tiêu theo danh mục"
                android:textSize="17sp"
                android:textColor="@color/dark_green"
                android:textStyle="bold"
                android:layout_weight="1"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tv_period_range"
                android:text="--"
                android:textSize="13sp"
                android:textColor="@color/olive"
                android:background="@drawable/bg_badge_cream"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                />
            </LinearLayout>
            <com.example.bmmoney.view.DonutChartView
                android:id="@+id/donut_chart"
                android:layout_width="match_parent"
                android:layout_height="236dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="4dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/dot_burnt" />

                    <TextView
                android:id="@+id/cat_name_0"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginLeft="8dp"
                        android:text="Ăn uống"
                        android:textSize="15sp"
                        android:textColor="@color/olive" />

                    <TextView
                android:id="@+id/cat_pct_0"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="40%"
                        android:textSize="13sp"
                        android:textColor="@color/grey_gold" />

                    <TextView
                android:id="@+id/cat_amt_0"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:text="26.500.000 ₫"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:gravity="right"
                        android:textColor="@color/dark_green" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_track_light">

                    <View
                        android:id="@+id/cat_bar_0"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/bar_burnt" />
                </FrameLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/dot_olive" />

                    <TextView
                android:id="@+id/cat_name_1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginLeft="8dp"
                        android:text="Di chuyển"
                        android:textSize="15sp"
                        android:textColor="@color/olive" />

                    <TextView
                android:id="@+id/cat_pct_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="24%"
                        android:textSize="13sp"
                        android:textColor="@color/grey_gold" />

                    <TextView
                android:id="@+id/cat_amt_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:text="15.650.000 ₫"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:gravity="right"
                        android:textColor="@color/dark_green" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_track_light">

                    <View
                        android:id="@+id/cat_bar_1"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/bar_olive" />
                </FrameLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/dot_sandy" />

                    <TextView
                android:id="@+id/cat_name_2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginLeft="8dp"
                        android:text="Hóa đơn"
                        android:textSize="15sp"
                        android:textColor="@color/olive" />

                    <TextView
                android:id="@+id/cat_pct_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="18%"
                        android:textSize="13sp"
                        android:textColor="@color/grey_gold" />

                    <TextView
                android:id="@+id/cat_amt_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:text="11.980.000 ₫"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:gravity="right"
                        android:textColor="@color/dark_green" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_track_light">

                    <View
                        android:id="@+id/cat_bar_2"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/bar_sandy" />
                </FrameLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/dot_dark_green" />

                    <TextView
                android:id="@+id/cat_name_3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginLeft="8dp"
                        android:text="Mua sắm"
                        android:textSize="15sp"
                        android:textColor="@color/olive" />

                    <TextView
                android:id="@+id/cat_pct_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12%"
                        android:textSize="13sp"
                        android:textColor="@color/grey_gold" />

                    <TextView
                android:id="@+id/cat_amt_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:text="8.060.000 ₫"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:gravity="right"
                        android:textColor="@color/dark_green" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_track_light">

                    <View
                        android:id="@+id/cat_bar_3"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/bar_dark_green" />
                </FrameLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/dot_grey_gold" />

                    <TextView
                android:id="@+id/cat_name_4"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginLeft="8dp"
                        android:text="Khác"
                        android:textSize="15sp"
                        android:textColor="@color/olive" />

                    <TextView
                android:id="@+id/cat_pct_4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="6%"
                        android:textSize="13sp"
                        android:textColor="@color/grey_gold" />

                    <TextView
                android:id="@+id/cat_amt_4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:text="3.381.000 ₫"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:gravity="right"
                        android:textColor="@color/dark_green" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_track_light">

                    <View
                        android:id="@+id/cat_bar_4"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/bar_grey_gold" />
                </FrameLayout>
            </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!--
        Ban va 02/08: hai o Vay no / Tra no.
        Dat ngay duoi the "Chi tieu theo danh muc", tren "Giao dich gan day".
        Bo cuc sao y hai o "So thang truoc" / "Ngay con lai" o cuoi man hinh.
    -->
    <!-- ===================== Ban va 03/08: Gia tri rong ===================== -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:cardBackgroundColor="@color/card_cream"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Giá trị ròng"
                    android:textColor="@color/subtle_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/help_net_worth"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginLeft="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textColor="@color/burnt"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_net_worth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="0 ₫"
                android:textColor="@color/dark_green"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_net_worth_formula"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Tiền trong ví + phải thu − phải trả"
                android:textColor="@color/olive"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btn_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_pill_olive"
                android:clickable="true"
                android:focusable="true"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="⚖ Cân bằng số dư"
                android:textColor="@color/cream"
                android:textSize="13sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:background="@color/hairline" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tiền trong ví"
                        android:textColor="@color/subtle_text"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_wallet_balance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="0 ₫"
                        android:textColor="@color/dark_green"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lãi lỗ kỳ này"
                        android:textColor="@color/subtle_text"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_net_profit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="0 ₫"
                        android:textColor="@color/net_positive"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="0dp"
            android:layout_marginRight="8dp"
            app:cardBackgroundColor="@color/card_cream"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="16dp">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/bg_lend">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_arrow_up"
                        app:tint="@color/sandy" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:text="Phải thu (cho vay)"
                    android:textColor="@color/olive"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_lend_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="2dp"
                    android:text="0 ₫"
                    android:textColor="@color/sandy"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_lend_open"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="2dp"
                    android:text="Còn phải thu 0 ₫"
                    android:textColor="@color/subtle_text"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="0dp"
            app:cardBackgroundColor="@color/card_cream"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="16dp">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/bg_debt">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_arrow_down"
                        app:tint="@color/dark_green" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:text="Phải trả (đi vay)"
                    android:textColor="@color/olive"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_debt_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="2dp"
                    android:text="0 ₫"
                    android:textColor="@color/dark_green"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_debt_open"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="2dp"
                    android:text="Còn phải trả 0 ₫"
                    android:textColor="@color/subtle_text"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:cardBackgroundColor="@color/card_cream"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                >
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Giao dịch gần đây"
                android:textSize="17sp"
                android:textColor="@color/dark_green"
                android:textStyle="bold"
                android:layout_weight="1"
                />
            <TextView
                android:id="@+id/btn_view_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Xem tất cả"
                android:textSize="15sp"
                android:textColor="@color/burnt"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_recent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/tv_empty_recent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:padding="16dp"
                android:background="@drawable/bg_field"
                android:text="Chưa có giao dịch nào. Hãy thêm chi tiêu đầu tiên!"
                android:textSize="14sp"
                android:textColor="@color/olive"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="0dp"
            android:layout_marginRight="8dp"
            app:cardBackgroundColor="@color/card_cream"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="16dp">
            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_light_green"
                android:layout_gravity="center_horizontal"
                >
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_trending_up"
                    app:tint="@color/olive" />
            </FrameLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_gravity="center_horizontal"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="So tháng trước"
                    android:textSize="13sp"
                    android:textColor="@color/olive" />

                <TextView
                    android:id="@+id/help_vs_last_month"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginLeft="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textColor="@color/burnt"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <TextView
                android:id="@+id/tv_vs_last_month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="+8.5%"
                android:textSize="16sp"
                android:textColor="@color/burnt"
                android:textStyle="bold"
                android:layout_gravity="center_horizontal"
                />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="0dp"
            app:cardBackgroundColor="@color/card_cream"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="16dp">
            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_sand"
                android:layout_gravity="center_horizontal"
                >
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_calendar"
                    app:tint="@color/burnt" />
            </FrameLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Ngày còn lại"
                android:textSize="13sp"
                android:textColor="@color/olive"
                android:layout_gravity="center_horizontal"
                />
            <TextView
                android:id="@+id/tv_days_left_stat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="9 ngày"
                android:textSize="16sp"
                android:textColor="@color/dark_green"
                android:textStyle="bold"
                android:layout_gravity="center_horizontal"
                />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    </LinearLayout>
</ScrollView>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
