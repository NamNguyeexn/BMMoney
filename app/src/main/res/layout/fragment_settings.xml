<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/refresh_settings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream">

    <ScrollView 
    
    android:id="@+id/screen_settings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="120dp">


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:text="Cài đặt"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/dark_green" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:cardBackgroundColor="@color/card_cream"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_user"
                    app:tint="@color/olive" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="8dp"
                    android:text="Hồ sơ cá nhân"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/dark_green" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <TextView
                android:id="@+id/tv_avatar"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:gravity="center"
                    android:background="@drawable/bg_avatar_gradient"
                    android:elevation="3dp"
                    android:text="NL"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/cream" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Họ và tên"
                        android:textSize="13sp"
                        android:textColor="@color/olive" />

                    <EditText
                        android:id="@+id/edt_name"
                android:inputType="textCapSentences|textPersonName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:padding="8dp"
                        android:background="@drawable/bg_field_small"
                        android:hint="Nhập họ tên"
                        android:textColorHint="@color/subtle_text"
                        android:textSize="14sp"
                        android:textColor="@color/dark_green" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Ngân sách hàng tháng"
                        android:textSize="13sp"
                        android:textColor="@color/olive" />

                    <EditText
                        android:id="@+id/edt_budget"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:padding="8dp"
                        android:background="@drawable/bg_field_small"
                        android:hint="80.500.000"
                        android:inputType="number"
                        android:textColorHint="@color/subtle_text"
                        android:textSize="14sp"
                        android:textColor="@color/dark_green" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:cardBackgroundColor="@color/card_cream"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_cloud"
                    app:tint="@color/olive" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="8dp"
                    android:text="Đồng bộ &amp; Sao lưu"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/dark_green" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp"
                android:padding="16dp"
                android:background="@drawable/bg_field">

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_icon_olive">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_database"
                        app:tint="@color/olive" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sao lưu Google Drive"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/dark_green" />

                    <TextView
                android:id="@+id/tv_last_backup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sao lưu lần cuối: 2 giờ trước"
                        android:textSize="12sp"
                        android:textColor="@color/olive" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:background="@drawable/bg_badge_olive_light"
                    android:text="Đã kết nối"
                    android:textSize="11sp"
                    android:textColor="@color/olive" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">
                <TextView
                android:id="@+id/btn_backup_now"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="0dp"
                    android:gravity="center"
                    android:padding="12dp"
                    android:background="@drawable/bg_field_small"
                    android:text="Sao lưu ngay"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/olive"
                    android:clickable="true"
                    android:focusable="true" />
                <TextView
                android:id="@+id/btn_sync_now"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="12dp"
                    android:gravity="center"
                    android:padding="12dp"
                    android:background="@drawable/bg_field_small"
                    android:text="Đồng bộ dữ liệu"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/olive"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:cardBackgroundColor="@color/card_cream"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_tags"
                    app:tint="@color/olive" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="8dp"
                    android:text="Danh mục tùy chỉnh"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/dark_green" />

                <FrameLayout
                    android:id="@+id/btn_add_category"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_olive_small"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_add"
                        app:tint="@color/cream" />
                </FrameLayout>
            </LinearLayout>
            <ScrollView
                android:id="@+id/scroll_categories"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:nestedScrollingEnabled="true"
                android:scrollbars="none">
            <LinearLayout
                android:id="@+id/container_categories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
            </ScrollView>

            <TextView
                android:id="@+id/tv_no_category"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Chưa có danh mục nào. Nhấn dấu + để thêm."
                android:textSize="13sp"
                android:textColor="@color/olive" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:cardBackgroundColor="@color/card_cream"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/olive" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:text="Tùy chọn"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/dark_green" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ngày chốt chu kỳ"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/olive" />

                <TextView
                    android:id="@+id/tv_cycle_day"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:paddingLeft="12dp"
                    android:background="@drawable/bg_field"
                    android:text="--"
                    android:textSize="15sp"
                    android:textColor="@color/dark_green"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Mọi số liệu được tính theo chu kỳ kết thúc vào ngày này."
                    android:textSize="12sp"
                    android:textColor="@color/olive" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ngưỡng chi tiêu"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/olive" />

                <TextView
                    android:id="@+id/tv_warn_percent"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:paddingLeft="12dp"
                    android:background="@drawable/bg_field"
                    android:text="--"
                    android:textSize="15sp"
                    android:textColor="@color/dark_green"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Vượt mức này sẽ hiện cảnh báo ở trang chủ."
                    android:textSize="12sp"
                    android:textColor="@color/olive" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mốc chi tiêu lớn"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/olive" />

                <TextView
                    android:id="@+id/tv_big_percent"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:paddingLeft="12dp"
                    android:background="@drawable/bg_field"
                    android:text="--"
                    android:textSize="15sp"
                    android:textColor="@color/dark_green"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Giao dịch chiếm từ mức này trở lên sẽ được đánh dấu là khoản chi đáng chú ý."
                    android:textSize="12sp"
                    android:textColor="@color/olive" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="20dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Nhắc ghi chú chi tiêu"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/olive" />

                <FrameLayout
                    android:id="@+id/btn_add_reminder"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_olive_small"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_add"
                        app:tint="@color/cream" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/container_reminders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tv_no_reminder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Chưa có lời nhắc nào. Nhấn + để thêm giờ nhắc ghi chi tiêu."
                android:textSize="12sp"
                android:textColor="@color/olive" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:cardBackgroundColor="@color/chip_cream"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:id="@+id/tv_app_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QuanLyChiTieu v2.1.0"
                android:textSize="14sp"
                android:textColor="@color/olive"
                android:layout_gravity="center_horizontal"
                />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Điều khoản"
                    android:textSize="14sp"
                    android:textColor="@color/olive"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:text="Quyền riêng tư"
                    android:textSize="14sp"
                    android:textColor="@color/olive"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:text="Trợ giúp"
                    android:textSize="14sp"
                    android:textColor="@color/olive"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
