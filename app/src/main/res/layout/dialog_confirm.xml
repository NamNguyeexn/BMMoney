<?xml version="1.0" encoding="utf-8"?>
<!--
  Ban va 03/08. Hop thoai xac nhan dung chung cho ca app.

  Truoc day cac man dung AlertDialog cua he thong voi Theme_Bmm_Dialog. Nhung
  "android:background" trong theme KHONG doi duoc nen cua cua so AlertDialog,
  nen thuc te van ra hop thoai trang, goc vuong, nut chu hoa xanh duong - lac
  han voi tong kem/o liu/nau dat cua app.

  Nay dung layout rieng, cung bo drawable voi dialog_tx.xml.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_confirm_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_burnt_soft"
            android:gravity="center"
            android:text="!"
            android:textColor="@color/burnt"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_confirm_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_weight="1"
            android:text="Xác nhận"
            android:textColor="@color/dark_green"
            android:textSize="19sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_confirm_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_field"
        android:lineSpacingExtra="3dp"
        android:padding="12dp"
        android:text=""
        android:textColor="@color/olive"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/btn_confirm_yes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_burnt_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingTop="13dp"
        android:paddingBottom="13dp"
        android:text="Xóa"
        android:textColor="@color/cream"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btn_confirm_alt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_pill_olive"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingTop="13dp"
        android:paddingBottom="13dp"
        android:text=""
        android:textColor="@color/cream"
        android:textSize="17sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/btn_confirm_no"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_pill_cream"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingTop="13dp"
        android:paddingBottom="13dp"
        android:text="Giữ lại"
        android:textColor="@color/olive"
        android:textSize="17sp"
        android:textStyle="bold" />
</LinearLayout>
