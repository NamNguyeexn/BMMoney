<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_main">
<ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:paddingBottom="96dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingTop="10dp"><TextView android:id="@+id/btnBack" android:layout_width="42dp" android:layout_height="42dp" android:gravity="center" android:text="‹" android:textSize="30sp" android:textColor="#606C38" android:background="@drawable/bg_panel_new"/><TextView android:text="Thêm chi tiêu" android:textColor="#283618" android:textSize="25sp" android:textStyle="bold" android:layout_marginStart="14dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_ai_dashed"><TextView android:text="📷" android:textSize="38sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/><TextView android:text="Quét hóa đơn" android:textColor="#283618" android:textSize="19sp" android:textStyle="bold" android:layout_marginTop="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/><TextView android:text="Dùng AI để tự động trích xuất thông tin chi tiêu" android:textColor="#606C38" android:textSize="13sp" android:gravity="center" android:layout_marginTop="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/><TextView android:id="@+id/btnScanReceipt" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="14dp" android:gravity="center" android:text="📷  Quét hóa đơn" android:textColor="#BC6C25" android:textStyle="bold" android:background="@drawable/bg_card_new"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="vertical" android:background="@drawable/bg_card_new"><TextView android:text="Số tiền *" android:textColor="#283618" android:textSize="17sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/><EditText android:id="@+id/edtAmount" android:layout_width="match_parent" android:layout_height="62dp" android:layout_marginTop="10dp" android:background="@drawable/bg_input_new" android:hint="156000" android:inputType="numberDecimal" android:gravity="center" android:textColor="#283618" android:textColorHint="#A0925A" android:textSize="26sp" android:textStyle="bold"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="vertical" android:background="@drawable/bg_card_new"><TextView android:text="Mô tả *" android:textColor="#283618" android:textSize="17sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/><EditText android:id="@+id/edtTitle" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:background="@drawable/bg_input_new" android:hint="VD: VinMart Trần Duy Hưng" android:textColor="#283618" android:textColorHint="#A0925A"/><TextView android:text="✨ Gợi ý AI: tự phân loại dựa trên mô tả" android:layout_marginTop="10dp" android:padding="12dp" android:background="@drawable/bg_ai_dashed" android:textColor="#606C38" android:textSize="13sp" android:layout_width="match_parent" android:layout_height="wrap_content"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="vertical" android:background="@drawable/bg_card_new"><TextView android:text="Loại giao dịch" android:textColor="#283618" android:textSize="17sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/><RadioGroup android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal"><RadioButton android:id="@+id/radioExpense" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:checked="true" android:text="Chi tiêu" android:textColor="#BC6C25"/><RadioButton android:id="@+id/radioIncome" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Thu nhập" android:textColor="#606C38"/></RadioGroup><TextView android:text="Danh mục" android:textColor="#283618" android:textStyle="bold" android:layout_marginTop="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/><Spinner android:id="@+id/spinnerCategory" android:layout_width="match_parent" android:layout_height="52dp" android:background="@drawable/bg_input_new"/></LinearLayout>
<EditText android:id="@+id/edtNote" android:layout_width="match_parent" android:layout_height="90dp" android:layout_marginTop="14dp" android:gravity="top" android:background="@drawable/bg_card_new" android:hint="Ghi chú thêm..." android:textColor="#283618" android:textColorHint="#A0925A"/>
<com.google.android.material.button.MaterialButton android:id="@+id/btnSave" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="18dp" android:backgroundTint="#606C38" android:text="Lưu giao dịch" android:textAllCaps="false" android:textColor="#FEFAE0" android:textSize="16sp"/>
</LinearLayout></ScrollView><include layout="@layout/include_bottom_nav_new"/></FrameLayout>
