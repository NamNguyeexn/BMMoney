<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:padding="10dp"
    android:background="@drawable/bg_row_cream"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/tv_cat_emoji"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:gravity="center"
        android:background="@drawable/bg_circle_cream"
        android:text="🏷"
        android:textSize="18sp" />

    <LinearLayout
        android:id="@+id/box_cat_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginLeft="12dp"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/tv_cat_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Danh mục"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/dark_green" />

        <TextView
            android:id="@+id/tv_cat_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Chưa dùng trong kỳ này"
            android:textSize="12sp"
            android:textColor="@color/olive" />
    </LinearLayout>

    <TextView
        android:id="@+id/btn_cat_up"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginLeft="4dp"
        android:gravity="center"
        android:background="@drawable/bg_circle_cream"
        android:text="↑"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/olive"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Đưa lên trên" />

    <TextView
        android:id="@+id/btn_cat_down"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginLeft="4dp"
        android:gravity="center"
        android:background="@drawable/bg_circle_cream"
        android:text="↓"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/olive"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Đưa xuống dưới" />

    <TextView
        android:id="@+id/btn_cat_remove"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginLeft="4dp"
        android:gravity="center"
        android:background="@drawable/bg_circle_burnt_soft"
        android:text="✕"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/burnt"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Xóa danh mục" />
</LinearLayout>
