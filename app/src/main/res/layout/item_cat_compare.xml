<?xml version="1.0" encoding="utf-8"?>
<!--
  Ban va 03/08. Mot dong trong "Phan tich theo danh muc".

  Truoc day bon danh muc duoc viet CUNG trong fragment_analytics.xml, moi khoi
  gan 90 dong, lap lai bon lan (~370 dong) va moi khoi lai cong them mot cap chu
  "Ky nay / Ky truoc". Nay tach ra mot dong dung lai, chu thich chi con MOT lan o
  dau the, va so danh muc hien thi khong con bi chot cung o con so bon.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_cc_rank"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/bg_circle_cream"
            android:gravity="center"
            android:text="1"
            android:textColor="@color/olive"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_cc_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Danh mục"
            android:textColor="@color/dark_green"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_cc_delta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:background="@drawable/bg_badge_cream"
            android:paddingLeft="7dp"
            android:paddingTop="2dp"
            android:paddingRight="7dp"
            android:paddingBottom="2dp"
            android:singleLine="true"
            android:text=""
            android:textColor="@color/olive"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_cc_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:singleLine="true"
            android:text="0 ₫"
            android:textColor="@color/burnt"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginTop="7dp"
        android:background="@drawable/bg_track_light">

        <View
            android:id="@+id/bar_cc_this"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/bar_burnt" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_track_light">

        <View
            android:id="@+id/bar_cc_last"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/bar_old_gold" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_cc_last_amount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text=""
        android:textColor="@color/grey_gold"
        android:textSize="13sp" />
</LinearLayout>
