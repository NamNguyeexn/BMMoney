<?xml version="1.0" encoding="utf-8"?>
<!--
  Ban va 03/08. Mot dong trong the "Cong no theo doi tac" o man Phan tich.
  Trai: chu cai dau ten. Giua: ten + con phai thu/phai tra. Phai: so du rong.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_field"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:minHeight="60dp"
    android:orientation="horizontal"
    android:padding="12dp">

    <TextView
        android:id="@+id/tv_partner_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_lend"
        android:gravity="center"
        android:text="A"
        android:textColor="@color/dark_green"
        android:textSize="17sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_partner_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="T\u00ean \u0111\u1ed1i t\u00e1c"
            android:textColor="@color/dark_green"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_partner_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Ph\u1ea3i thu 0 \u20ab"
            android:textColor="@color/olive"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_partner_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:singleLine="true"
        android:text="0 \u20ab"
        android:textColor="@color/net_positive"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
