<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog"
    android:padding="20dp">

    <TextView
        android:id="@+id/tv_reminder_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lời nhắc ghi chi tiêu"
        android:textSize="19sp"
        android:textStyle="bold"
        android:textColor="@color/dark_green" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_row_cream"
        android:padding="8dp">

        <NumberPicker
            android:id="@+id/rm_hour"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:text=":"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="@color/dark_green" />

        <NumberPicker
            android:id="@+id/rm_minute"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <EditText
        android:id="@+id/edt_reminder_label"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:paddingLeft="12dp"
        android:background="@drawable/bg_field"
        android:hint="Ghi chú cho lời nhắc"
        android:inputType="textCapSentences"
        android:textSize="15sp"
        android:textColor="@color/dark_green"
        android:textColorHint="@color/subtle_text" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="16dp">

        <TextView
            android:id="@+id/btn_reminder_delete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:background="@drawable/bg_pill_cream"
            android:text="Xoá"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/burnt"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btn_reminder_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:background="@drawable/bg_pill_cream"
            android:text="Huỷ"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/olive"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btn_reminder_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:background="@drawable/bg_pill_olive"
            android:text="Lưu"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/cream"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</LinearLayout>
