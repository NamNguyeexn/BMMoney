<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/screen_analytics"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="24dp">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Phân tích"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/dark_green" />

        <TextView
                android:id="@+id/btn_period_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="@drawable/bg_pill_olive"
            android:text="Chu kỳ"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/cream"
            android:clickable="true"
            android:focusable="true" />

        <TextView
                android:id="@+id/btn_period_year"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="@drawable/bg_pill_cream"
            android:text="Năm"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/olive"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:cardBackgroundColor="@color/card_cream"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Xu hướng chi tiêu theo chu kỳ"
                android:textSize="16sp"
                android:textColor="@color/dark_green"
                android:textStyle="bold"
                />
            <com.example.bmmoney.view.TrendChartView
                android:id="@+id/trend_chart"
                android:layout_width="match_parent"
                android:layout_height="192dp"
                android:layout_marginTop="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp"
                android:padding="12dp"
                android:background="@drawable/bg_field">

                <FrameLayout
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_icon_olive">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_arrow_up"
                        app:tint="@color/olive" />
                </FrameLayout>

                <TextView
                android:id="@+id/tv_trend_summary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="8dp"
                    android:text="+8.5% so tháng trước"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/dark_green" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:background="@drawable/bg_badge_cream"
                android:id="@+id/tv_trend_period"
                    android:text="--"
                    android:textSize="12sp"
                    android:textColor="@color/olive" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:cardBackgroundColor="@color/card_cream"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phân tích theo danh mục"
                android:textSize="16sp"
                android:textColor="@color/dark_green"
                android:textStyle="bold"
                />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                android:id="@+id/an_name_0"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Ăn uống"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/dark_green" />

                    <TextView
                android:id="@+id/an_amt_0"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="26.450 ₫"
                        android:textSize="14sp"
                        android:textColor="@color/olive" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="24dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_track_light">

                        <View
                            android:id="@+id/an_this_0"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/bar_burnt" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="24dp"
                        android:layout_weight="1"
                        android:layout_marginLeft="8dp"
                        android:background="@drawable/bg_track_light">

                        <View
                            android:id="@+id/an_last_0"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/bar_old_gold" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Kỳ này"
                        android:textSize="12sp"
                        android:textColor="@color/olive" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kỳ trước"
                        android:textSize="12sp"
                        android:textColor="@color/olive" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                android:id="@+id/an_name_1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Di chuyển"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/dark_green" />

                    <TextView
                android:id="@+id/an_amt_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="15.640 ₫"
                        android:textSize="14sp"
                        android:textColor="@color/olive" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="24dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_track_light">

                        <View
                            android:id="@+id/an_this_1"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/bar_olive" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="24dp"
                        android:layout_weight="1"
                        android:layout_marginLeft="8dp"
                        android:background="@drawable/bg_track_light">

                        <View
                            android:id="@+id/an_last_1"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/bar_old_gold" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Kỳ này"
                        android:textSize="12sp"
                        android:textColor="@color/olive" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kỳ trước"
                        android:textSize="12sp"
                        android:textColor="@color/olive" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                android:id="@+id/an_name_2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Hóa đơn"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/dark_green" />

                    <TextView
                android:id="@+id/an_amt_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="11.960 ₫"
                        android:textSize="14sp"
                        android:textColor="@color/olive" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="24dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_track_light">

                        <View
                            android:id="@+id/an_this_2"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/bar_sandy" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="24dp"
                        android:layout_weight="1"
                        android:layout_marginLeft="8dp"
                        android:background="@drawable/bg_track_light">

                        <View
                            android:id="@+id/an_last_2"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/bar_old_gold" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Kỳ này"
                        android:textSize="12sp"
                        android:textColor="@color/olive" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kỳ trước"
                        android:textSize="12sp"
                        android:textColor="@color/olive" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                android:id="@+id/an_name_3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Mua sắm"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/dark_green" />

                    <TextView
                android:id="@+id/an_amt_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="8.050 ₫"
                        android:textSize="14sp"
                        android:textColor="@color/olive" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="24dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_track_light">

                        <View
                            android:id="@+id/an_this_3"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/bar_dark_green" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="24dp"
                        android:layout_weight="1"
                        android:layout_marginLeft="8dp"
                        android:background="@drawable/bg_track_light">

                        <View
                            android:id="@+id/an_last_3"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/bar_old_gold" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Kỳ này"
                        android:textSize="12sp"
                        android:textColor="@color/olive" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kỳ trước"
                        android:textSize="12sp"
                        android:textColor="@color/olive" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="0dp"
            app:cardBackgroundColor="@color/card_cream"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="16dp">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_icon_olive">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_arrow_down"
                        app:tint="@color/olive" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Danh mục tốt nhất"
                    android:textSize="12sp"
                    android:textColor="@color/olive" />

                <TextView
                        android:id="@+id/tv_best_category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Di chuyển"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/dark_green" />

                <TextView
                android:id="@+id/tv_best_note"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="-15% tiết kiệm"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/olive" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="12dp"
            app:cardBackgroundColor="@color/card_cream"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="16dp">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_icon_sand">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_arrow_up"
                        app:tint="@color/burnt" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Cần chú ý"
                    android:textSize="12sp"
                    android:textColor="@color/olive" />

                <TextView
                        android:id="@+id/tv_worst_category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Ăn uống"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/dark_green" />

                <TextView
                android:id="@+id/tv_worst_note"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="+25% vượt mức"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/burnt" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    </LinearLayout>
</ScrollView>
