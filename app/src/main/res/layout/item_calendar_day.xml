<?xml version="1.0" encoding="utf-8"?>
<!--
    Ban va 02/08: mot o ngay tren lich.
    Chieu cao co dinh 44dp de bay hang thang nao cung deu nhau.
    Cham nho nam ngay duoi so ngay duong lich; do dam cua cham cho biet
    muc bien dong tai chinh cua ngay hom do so voi moc dang chu y.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="46dp"
    android:layout_weight="1"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/day_box"
        android:layout_width="34dp"
        android:layout_height="30dp">

        <TextView
            android:id="@+id/tv_day"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="1"
            android:textColor="@color/dark_green"
            android:textSize="16sp" />
    </FrameLayout>

    <View
        android:id="@+id/day_dot"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_marginTop="2dp"
        android:background="@drawable/dot_cal_light"
        android:visibility="invisible" />
</LinearLayout>
