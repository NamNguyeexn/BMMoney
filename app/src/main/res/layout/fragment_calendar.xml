<?xml version="1.0" encoding="utf-8"?>
<!--
    Ban va 02/08: man Lich.
    Bo cuc theo dung chu de app: nen cream, the card_cream bo goc 16dp,
    chu dark_green, nhan phu subtle_text.
-->
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/refresh_calendar"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/screen_calendar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/cream"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="@dimen/screen_padding"
            android:paddingRight="@dimen/screen_padding"
            android:paddingBottom="24dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/status_bar_height" />

            <!-- ============================ Tieu de ============================ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Lịch"
                android:textColor="@color/dark_green"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Nhịp độ tài chính theo từng ngày"
                android:textColor="@color/olive"
                android:textSize="13sp" />

            <!-- ============================ The lich ============================ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/card_cream"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Thanh dieu huong thang -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/btn_prev_month"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_icon_chip"
                            android:clickable="true"
                            android:contentDescription="Tháng trước"
                            android:focusable="true"
                            android:padding="8dp"
                            android:src="@drawable/ic_arrow_left"
                            app:tint="@color/dark_green" />

                        <TextView
                            android:id="@+id/tv_month_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="Tháng 8/2026"
                            android:textColor="@color/dark_green"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/btn_next_month"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_icon_chip"
                            android:clickable="true"
                            android:contentDescription="Tháng sau"
                            android:focusable="true"
                            android:padding="8dp"
                            android:rotation="180"
                            android:src="@drawable/ic_arrow_left"
                            app:tint="@color/dark_green" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_month_total"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text=""
                        android:textColor="@color/olive"
                        android:textSize="12sp" />

                    <!-- Hang thu trong tuan -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/BmmWeekday"
                            android:text="T2" />

                        <TextView
                            style="@style/BmmWeekday"
                            android:text="T3" />

                        <TextView
                            style="@style/BmmWeekday"
                            android:text="T4" />

                        <TextView
                            style="@style/BmmWeekday"
                            android:text="T5" />

                        <TextView
                            style="@style/BmmWeekday"
                            android:text="T6" />

                        <TextView
                            style="@style/BmmWeekday"
                            android:text="T7" />

                        <TextView
                            style="@style/BmmWeekday"
                            android:text="CN" />
                    </LinearLayout>

                    <!-- Luoi ngay: sau hang, moi hang bay o, dung code do vao -->
                    <LinearLayout
                        android:id="@+id/container_weeks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="vertical" />

                    <!-- Chu thich muc do bien dong -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:background="@drawable/dot_cal_strong" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="6dp"
                            android:text="Vượt mốc"
                            android:textColor="@color/olive"
                            android:textSize="11sp" />

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:layout_marginLeft="14dp"
                            android:background="@drawable/dot_cal_medium" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="6dp"
                            android:text="Đạt 50% mốc"
                            android:textColor="@color/olive"
                            android:textSize="11sp" />

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:layout_marginLeft="14dp"
                            android:background="@drawable/dot_cal_light" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="6dp"
                            android:text="Có giao dịch"
                            android:textColor="@color/olive"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ==================== The ban ghi cua ngay dang chon ==================== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/card_cream"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_day_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Ngày 01/08/2026"
                            android:textColor="@color/dark_green"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_day_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_cream"
                            android:paddingLeft="8dp"
                            android:paddingTop="4dp"
                            android:paddingRight="8dp"
                            android:paddingBottom="4dp"
                            android:text="0 bản ghi"
                            android:textColor="@color/olive"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_day_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text=""
                        android:textColor="@color/olive"
                        android:textSize="12sp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recycler_day"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:overScrollMode="never" />

                    <TextView
                        android:id="@+id/tv_empty_day"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:padding="16dp"
                        android:text="Ngày này không có bản ghi nào"
                        android:textColor="@color/subtle_text"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
